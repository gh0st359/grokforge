# Copy to .env and fill in. docker compose will pick this up automatically.
#
# All values below are OPTIONAL. If GROK_API_KEY is unset, the agents service
# runs in deterministic mock mode and the full stack still boots — useful for
# local dev, CI, and offline demos.

# xAI API
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_PRIMARY_MODEL=grok-4-3
GROK_FALLBACK_MODEL=grok-4-mini

# Verifier behaviour
MAX_DEBATE_ROUNDS=4
CONFIDENCE_THRESHOLD=0.95
